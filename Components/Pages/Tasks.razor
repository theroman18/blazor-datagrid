@page "/tasks"

<PageTitle>Tasks</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="Tasks" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=6>
     <RadzenCard style="height: 100%">
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"   AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@(tasks)" TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" RowSelect="@EditRow">
            <Columns>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="Id" Title="Id">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="Title" Title="Title">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="Opportunity.UserId" Title="Opportunity">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="DueDate" Title="Due Date">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="TaskType.Name" Title="Task Type">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="TaskStatus.Name" Title="Task Status">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="task">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, task)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>
    </RadzenCard>

    </RadzenColumn>
        <RadzenColumn SizeMD=6>
        <RadzenCard style="height: 100%;margin-top:0px;">
            <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">Cannot save Task</RadzenAlert>
            <RadzenTemplateForm TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Data="@(task)" Visible="@(task != null)" Submit="@FormSubmit">
              <RadzenStack>
                <RadzenFormField Text="Title" Variant="Variant.Filled">
                      <ChildContent>
                        <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(task.Title)" Name="Title" />
                  </ChildContent>
                </RadzenFormField>
                <RadzenFormField Text="Opportunity" Variant="Variant.Filled">
                      <ChildContent>
                        <RadzenDropDownDataGrid Data="@(opportunitiesForOpportunityId)" TextProperty="UserId" ValueProperty="Id" AllowClear=true
                              style="display: block; width: 100%" @bind-Value="@(task.OpportunityId)" Name="OpportunityId"
                               />
                  </ChildContent>
                </RadzenFormField>
                <RadzenFormField Text="Due Date" Variant="Variant.Filled">
                      <ChildContent>
                        <RadzenDatePicker DateFormat="MM/dd/yyyy" style="display: block; width: 100%" @bind-Value="@(task.DueDate)" Name="DueDate" />
                      </ChildContent>    
                      <Helper>
                        <RadzenRequiredValidator Component="DueDate" Text="DueDate is required" />
                      </Helper>
                </RadzenFormField>
                <RadzenFormField Text="Task Type" Variant="Variant.Filled">
                      <ChildContent>
                        <RadzenDropDownDataGrid Data="@(taskTypesForTypeId)" TextProperty="Name" ValueProperty="Id" AllowClear=true
                              style="display: block; width: 100%" @bind-Value="@(task.TypeId)" Name="TypeId"
                               />
                  </ChildContent>
                </RadzenFormField>
                <RadzenFormField Text="Task Status" Variant="Variant.Filled">
                      <ChildContent>
                        <RadzenDropDownDataGrid Data="@(taskStatusesForStatusId)" TextProperty="Name" ValueProperty="Id" AllowClear=true
                              style="display: block; width: 100%" @bind-Value="@(task.StatusId)" Name="StatusId"
                               />
                  </ChildContent>
                </RadzenFormField>
              </RadzenStack>
              <RadzenStack style="margin-top:1rem;" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Save" Variant="Variant.Flat" />
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Variant="Variant.Flat" Click="@CancelButtonClick" Visible=false />
              </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
        </RadzenColumn>  </RadzenRow>
</RadzenStack>
