@page "/opportunity-statuses"

<PageTitle>OpportunityStatuses</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="OpportunityStatuses" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px" ExpandMode=DataGridExpandMode.Single  AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@(opportunityStatuses)" TItem="CRMBlazorServerRBS.Models.RadzenCRM.OpportunityStatus" RowSelect="@EditRow" RowExpand="@GetChildData">
            <Columns>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.OpportunityStatus" Property="Id" Title="Id">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.OpportunityStatus" Property="Name" Title="Name">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.OpportunityStatus" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="opportunityStatus">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, opportunityStatus)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <Template Context="opportunityStatus">

                    <RadzenStack Class="rz-my-8">
                        <RadzenRow Gap="0" AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenText Visible="@(opportunityStatusChild != null)" Text="Opportunities" TextStyle="TextStyle.H4" TagName="TagName.H2" style="margin: 0" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                                    <RadzenButton Visible="@(opportunityStatusChild != null)" Icon="add_circle_outline" Text="Add" Click=@(args => OpportunitiesAddButtonClick(args,opportunityStatusChild)) />
                                </RadzenStack>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenDataGrid ColumnWidth="200px" Visible="@(opportunityStatusChild != null)" @ref=OpportunitiesDataGrid AllowFiltering="true" FilterMode="Radzen.FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
                          Data="@opportunityStatusChild?.Opportunities" TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity"  RowSelect="@(args => OpportunitiesRowSelect(args, opportunityStatusChild))">
                          <Columns>
                            <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="Id" Title="Id">
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="Amount" Title="Amount">
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="Contact.Email" Title="Contact">
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="OpportunityStatus.Name" Title="Opportunity Status">
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="CloseDate" Title="Close Date">
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="Name" Title="Name">
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                                <Template Context="opportunityChild">

                                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium" Shade="Shade.Lighter" Variant="Variant.Flat"
                                        Click=@(args => OpportunitiesDeleteButtonClick(args, opportunityChild)) @onclick:stopPropagation="true" />
                                </Template>
                            </RadzenDataGridColumn>
                          </Columns>
                        </RadzenDataGrid>
                    </RadzenStack>
            </Template>
        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
