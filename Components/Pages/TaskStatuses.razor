@page "/task-statuses"

<PageTitle>TaskStatuses</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="TaskStatuses" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"  Render=Grid0Render AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@(taskStatuses)" TItem="CRMBlazorServerRBS.Models.RadzenCRM.TaskStatus" RowDoubleClick="@EditRow" RowSelect="@GetChildData">
            <Columns>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.TaskStatus" Property="Id" Title="Id">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.TaskStatus" Property="Name" Title="Name">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.TaskStatus" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                    <Template Context="taskStatus">

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, taskStatus)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

                <RadzenStack Class="rz-my-8">
                    <RadzenRow Gap="0" AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenText Visible="@(taskStatusChild != null)" Text="Tasks" TextStyle="TextStyle.H4" TagName="TagName.H2" style="margin: 0" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                                <RadzenButton Visible="@(taskStatusChild != null)" Icon="add_circle_outline" Text="Add" Click=@(args => TasksAddButtonClick(args,taskStatusChild)) />
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenDataGrid ColumnWidth="200px" Visible="@(taskStatusChild != null)" @ref=TasksDataGrid AllowFiltering="true" FilterMode="Radzen.FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
                      Data="@taskStatusChild?.Tasks" TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task"  RowSelect="@(args => TasksRowSelect(args, taskStatusChild))">
                      <Columns>
                        <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="Id" Title="Id">
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="Title" Title="Title">
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="Opportunity.UserId" Title="Opportunity">
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="DueDate" Title="Due Date">
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="TaskType.Name" Title="Task Type">
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Property="TaskStatus.Name" Title="Task Status">
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Task" Filterable="false" Sortable="false" Width="70px" TextAlign="TextAlign.Center">
                            <Template Context="taskChild">

                                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium" Shade="Shade.Lighter" Variant="Variant.Flat"
                                    Click=@(args => TasksDeleteButtonClick(args, taskChild)) @onclick:stopPropagation="true" />
                            </Template>
                        </RadzenDataGridColumn>
                      </Columns>
                    </RadzenDataGrid>
                </RadzenStack>
    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
