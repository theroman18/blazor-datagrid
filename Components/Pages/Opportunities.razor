@page "/opportunities"

<PageTitle>Opportunities</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="Opportunities" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"   AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@(opportunities)" RowUpdate="@GridRowUpdate" RowCreate="@GridRowCreate" TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity">
            <Columns>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="Id" Title="Id">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="Amount" Title="Amount">
                  <EditTemplate Context="opportunity">
                    <RadzenFormField Text="Amount" Variant="Variant.Filled">
                     <ChildContent>
                      <RadzenNumeric style="display: block; width: 100%" @bind-Value="@(opportunity.Amount)" Name="Amount" />
                     </ChildContent>
                     <Helper>
                      <RadzenRequiredValidator Component="Amount" Text="Amount is required"  />
                     </Helper>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="Contact.Email" Title="Contact">
                  <EditTemplate Context="opportunity">
                    <RadzenFormField Text="Contact" Variant="Variant.Filled">
                     <ChildContent>
                    <RadzenDropDownDataGrid Data="@(contactsForContactId)" TextProperty="Email" ValueProperty="Id" AllowClear=true
                         style="display: block; width: 100%" @bind-Value="@(opportunity.ContactId)" Name="ContactId"
                           />
                    </ChildContent>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="OpportunityStatus.Name" Title="Opportunity Status">
                  <EditTemplate Context="opportunity">
                    <RadzenFormField Text="Opportunity Status" Variant="Variant.Filled">
                     <ChildContent>
                    <RadzenDropDownDataGrid Data="@(opportunityStatusesForStatusId)" TextProperty="Name" ValueProperty="Id" AllowClear=true
                         style="display: block; width: 100%" @bind-Value="@(opportunity.StatusId)" Name="StatusId"
                           />
                    </ChildContent>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="CloseDate" Title="Close Date">
                  <EditTemplate Context="opportunity">
                    <RadzenFormField Text="Close Date" Variant="Variant.Filled">
                     <ChildContent>
                      <RadzenDatePicker DateFormat="MM/dd/yyyy" style="display: block; width: 100%" @bind-Value="@(opportunity.CloseDate)" Name="CloseDate" />
                     </ChildContent>
                     <Helper>
                      <RadzenRequiredValidator Component="CloseDate" Text="CloseDate is required"  />
                     </Helper>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Property="Name" Title="Name">
                  <EditTemplate Context="opportunity">
                    <RadzenFormField Text="Name" Variant="Variant.Filled">
                     <ChildContent>
                      <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(opportunity.Name)" Name="Name" />
                     </ChildContent>
                     <Helper>
                      <RadzenRequiredValidator Component="Name" Text="Name is required"  />
                     </Helper>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Opportunity" Filterable="false" Sortable="false" Width="156px" TextAlign="TextAlign.Center">
                    <EditTemplate Context="opportunity">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium"
                            style="margin-top: 0.25rem; margin-right: 0.25rem; margin-bottom: 0.25rem"
                            Click=@(args => SaveButtonClick(args, opportunity)) @onclick:stopPropagation="true" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium"
                            Click=@(args => CancelButtonClick(args, opportunity)) @onclick:stopPropagation="true" />
                    </EditTemplate>
                    <Template Context="opportunity">

                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium"
                            style="margin-top: 0.25rem; margin-right: 0.25rem; margin-bottom: 0.25rem"
                            Click=@(args => EditButtonClick(args, opportunity)) @onclick:stopPropagation="true" />

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, opportunity)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
