@page "/contacts"

<PageTitle>Contacts</PageTitle>
<RadzenStack>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenText Text="Contacts" TextStyle="TextStyle.H3" TagName="TagName.H1" style="margin: 0" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenSplitButton Icon="get_app" Text="Export" Click="@ExportClick" Variant="Variant.Flat" Shade="Shade.Lighter">
                    <RadzenSplitButtonItem Text="Excel" Value="xlsx" />
                    <RadzenSplitButtonItem Text="CSV" Value="csv" />
                </RadzenSplitButton>
                <RadzenButton Icon="add_circle_outline" Text="Add" Click="@AddButtonClick" Variant="Variant.Flat" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenTextBox Placeholder="Search ..." style="display: block; width: 100%" @oninput="@Search" aria-label="Search by all string columns" />
    <RadzenRow>
      <RadzenColumn SizeMD=12>
        <RadzenDataGrid @ref="grid0" ColumnWidth="200px"   AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" ShowPagingSummary="true" PageSizeOptions=@(new int[]{5, 10, 20, 30})
            Data="@(contacts)" RowUpdate="@GridRowUpdate" RowCreate="@GridRowCreate" TItem="CRMBlazorServerRBS.Models.RadzenCRM.Contact">
            <Columns>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Contact" Property="Id" Title="Id">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Contact" Property="Email" Title="Email">
                  <EditTemplate Context="contact">
                    <RadzenFormField Text="Email" Variant="Variant.Filled">
                     <ChildContent>
                      <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(contact.Email)" Name="Email" />
                     </ChildContent>
                     <Helper>
                      <RadzenRequiredValidator Component="Email" Text="Email is required"  />
                     </Helper>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Contact" Property="Company" Title="Company">
                  <EditTemplate Context="contact">
                    <RadzenFormField Text="Company" Variant="Variant.Filled">
                     <ChildContent>
                      <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(contact.Company)" Name="Company" />
                    </ChildContent>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Contact" Property="LastName" Title="Last Name">
                  <EditTemplate Context="contact">
                    <RadzenFormField Text="Last Name" Variant="Variant.Filled">
                     <ChildContent>
                      <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(contact.LastName)" Name="LastName" />
                    </ChildContent>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Contact" Property="FirstName" Title="First Name">
                  <EditTemplate Context="contact">
                    <RadzenFormField Text="First Name" Variant="Variant.Filled">
                     <ChildContent>
                      <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(contact.FirstName)" Name="FirstName" />
                    </ChildContent>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Contact" Property="Phone" Title="Phone">
                  <EditTemplate Context="contact">
                    <RadzenFormField Text="Phone" Variant="Variant.Filled">
                     <ChildContent>
                      <RadzenTextBox style="display: block; width: 100%" @bind-Value="@(contact.Phone)" Name="Phone" />
                    </ChildContent>
                   </RadzenFormField>
                  </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CRMBlazorServerRBS.Models.RadzenCRM.Contact" Filterable="false" Sortable="false" Width="156px" TextAlign="TextAlign.Center">
                    <EditTemplate Context="contact">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium"
                            style="margin-top: 0.25rem; margin-right: 0.25rem; margin-bottom: 0.25rem"
                            Click=@(args => SaveButtonClick(args, contact)) @onclick:stopPropagation="true" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium"
                            Click=@(args => CancelButtonClick(args, contact)) @onclick:stopPropagation="true" />
                    </EditTemplate>
                    <Template Context="contact">

                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium"
                            style="margin-top: 0.25rem; margin-right: 0.25rem; margin-bottom: 0.25rem"
                            Click=@(args => EditButtonClick(args, contact)) @onclick:stopPropagation="true" />

                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Medium"
                            Shade="Shade.Lighter" Variant="Variant.Flat"
                            Click=@(args => GridDeleteButtonClick(args, contact)) @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>

    </RadzenColumn>
  </RadzenRow>
</RadzenStack>
